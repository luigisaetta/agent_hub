# Deep Agents 01 local configuration sample
# Copy to: agents/deep_agents01/.env.local

# OCI OpenAI-compatible API key
OPENAI_API_KEY=YOUR_OCI_API_KEY

# OCI project id (used as OpenAI-Project header)
OPENAI_PROJECT_ID=YOUR_OCI_PROJECT_ID

# Optional model override (default is openai.gpt-5.4)
# DEEP_AGENTS_MODEL=openai.gpt-5.4

# Optional region override used by config.py
# AGENT_HUB_REGION=us-chicago-1
