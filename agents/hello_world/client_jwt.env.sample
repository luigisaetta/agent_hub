# Hello World JWT client dedicated local configuration
# Save a local copy as:
#   agents/hello_world/.env.client_jwt.local

AGENT_URL=http://127.0.0.1:8080/chat
OCI_DOMAIN_URL=https://idcs-xxxxxxxxxxxxxxxxxxxxxxxx.identity.oraclecloud.com:443
OCI_CLIENT_ID=YOUR_CLIENT_ID
OCI_CLIENT_SECRET=YOUR_CLIENT_SECRET
OCI_SCOPE=invoke

# Optional: if empty, token endpoint is auto-resolved as
# <OCI_DOMAIN_URL>/oauth2/v1/token
OCI_TOKEN_URL=

REQUEST_TIMEOUT_SECONDS=60
DEBUG_TOKEN_HTTP_REQUEST=true
