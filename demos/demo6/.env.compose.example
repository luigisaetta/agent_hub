# Compose/runtime settings for demo6 backend API container.
# Copy this file to demos/demo6/.env.compose and edit as needed.

# Host port exposed for FastAPI service.
DEMO6_HOST_PORT=8080

# Optional explicit container and image names.
DEMO6_API_CONTAINER_NAME=demo6-api
DEMO6_IMAGE_NAME=agent-hub-demo6-api

# Uvicorn runtime tuning.
DEMO6_UVICORN_WORKERS=1
DEMO6_LOG_LEVEL=info

# OCI region used by config.py.
AGENT_HUB_REGION=us-chicago-1

# Absolute path to your secrets profile file used by config_private.py.
# Example:
# AGENT_HUB_SECRETS_FILE=/Users/<your-user>/Progetti/agent_hub/.env.prod-chicago
AGENT_HUB_SECRETS_FILE=/absolute/path/to/agent_hub/.env.prod-chicago
